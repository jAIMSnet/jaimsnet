# Secrets & credentials — never commit these
.env
.env.*
!.env.example
*.secret
*-secret.yaml

# Exception: InfisicalSecret CRD manifests are safe (reference paths, not values)
!secrets/infisical/sync/*.yaml

# Kubernetes credentials
kubeconfig
kubeconfig.*
*.kubeconfig
**/kube/config

# Private keys, certificates
*.pem
*.key
*.crt
!*.crt.example

# Infisical local config
.infisical.json

# Helm chart dependencies & caches
charts/
*.tgz
.helm/

# OpenTofu / Terraform state — NEVER commit state files
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
.tofu/
*.tfplan

# Terraform variable files with actual values (but keep examples)
*.tfvars
!*.tfvars.example

# Node.js
node_modules/

# Python
__pycache__/
*.pyc
.venv/

# Editor & OS
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~
Thumbs.db

# Temporary & build artifacts
tmp/
temp/
*.tmp
*.log
dist/
build/
